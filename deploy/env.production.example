# =============================================================================
# ChatFlow 后端 · 生产环境变量模板
#
# 部署位置: /var/www/chatflow/server/.env   （权限 600，owner=部署用户）
# 生成方式: ./deploy/setup-server.sh 会自动生成一份并打印出来
#
# ⚠️ 这个文件不进版本库，也不能被打包脚本覆盖（release 时显式排除 .env）
# =============================================================================

NODE_ENV=production

# 端口。Nginx 反代到这里；不要占 80/443
PORT=3100

# ---------------------------------------------------------------------------
# PostgreSQL
# 单机部署，走 unix socket 所在的 127.0.0.1:5432（不是开发环境的 5433）
# 密码由 setup-server.sh 随机生成，不要手抄开发环境的
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://chatflow:REPLACE_ME@127.0.0.1:5432/chatflow
# 生产不跑测试，这一项留空即可（NODE_ENV=production 时根本不会用到）
# TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis
# 只存在线状态（ZSET + 集合），丢了会自动重建，不需要持久化
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# 心跳时间窗必须 > 2 × Socket.IO pingInterval(25s)，否则网络抖一下就被判离线
PRESENCE_TTL_MS=60000
PRESENCE_SWEEP_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# JWT
# 必须用 `openssl rand -hex 32` 生成新值。
# 沿用开发环境那串的后果: 任何人从仓库历史里拿到它，就能伪造任意用户的 token
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=2h

# bcrypt 成本。2 核机器上每次登录约 70ms（阶段 9 实测 72.7ms），
# 这既是安全性的下限，也是"必须给登录限流"的原因
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# 跨域白名单
# 没有域名，前端就从 http://47.111.223.71 访问，所以写这个。
# 换域名/加 HTTPS 之后必须同步改成新地址，否则浏览器报 CORS 错误。
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://47.111.223.71

# 反向代理层数。Nginx → Node 是 1 层。
# 设为 0 或不设的后果不是"IP 显示不对"，而是限流全站共用一个桶。
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# 上传目录
# 必须是绝对值，且放在代码目录之外:
# 发版用 tar 覆盖 server/ 时不会碰到它，头像不会丢
# ---------------------------------------------------------------------------
UPLOAD_DIR=/var/www/chatflow/data/uploads
MAX_AVATAR_BYTES=2097152
