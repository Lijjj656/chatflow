# ============================================================
# ChatFlow 后端环境变量
# 用法: 复制本文件为 .env，按需修改。.env 不进版本库。
# ============================================================

# 运行环境: development | test | production
NODE_ENV=development

# HTTP 端口
PORT=3000

# ------------------------------------------------------------
# PostgreSQL
# 本地开发实例独立于 ThingsBoard 自带实例，端口 5433
# 格式: postgresql://<user>:<password>@<host>:<port>/<db>
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/chatflow
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/chatflow_test

# ------------------------------------------------------------
# Redis（阶段 6 才真正启用在线状态；未安装时服务可正常启动）
# ------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# 在线状态心跳时间窗（毫秒）。必须 > 2 × Socket.IO pingInterval(25s)，
# 否则网络抖一下就会把正常连接判成离线（头像随机变灰）。
PRESENCE_TTL_MS=60000
# 幽灵连接清扫间隔（毫秒）。进程被 kill -9 后，好友看到"离线"的最大延迟 ≈ TTL + 该值
PRESENCE_SWEEP_INTERVAL_MS=15000

# ------------------------------------------------------------
# JWT
# JWT_SECRET 必须 >= 32 字符。生产环境用 `openssl rand -hex 32` 重新生成
# ------------------------------------------------------------
JWT_SECRET=replace_me_with_a_random_32_byte_hex_string
JWT_EXPIRES_IN=2h

# 密码哈希成本因子
BCRYPT_ROUNDS=10

# ------------------------------------------------------------
# 跨域白名单，多个用逗号分隔
# 生产写前端实际访问的地址，例如 http://47.111.223.71
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# 反向代理层数。走 Nginx 反代时必须为 1，否则 req.ip 恒为 127.0.0.1，
# 全站用户共用同一个限流桶（登录变成"全球合计 10 次/15 分钟"）。
# 本地直连保持 0。不要设成 true —— 那会信任客户端伪造的 X-Forwarded-For。
TRUST_PROXY=0

# ------------------------------------------------------------
# 文件上传
# 相对路径按 server/ 解析（与启动目录无关）。
# 生产建议写绝对路径，放在代码目录之外，发版 --delete 时不会连头像一起删:
#   UPLOAD_DIR=/var/www/chatflow/data/uploads
# ------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_AVATAR_BYTES=2097152
