{
  "name": "chatflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatFlow 实时即时通讯系统 - 后端",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/e2e/smoke.mjs",
    "bench:prepare": "node scripts/bench/prepare.mjs",
    "bench:http": "node scripts/bench/http.mjs",
